# Variables d'environnement Flutter — Client BABIFIX
# Utilisation :
#   - Via flutter_dotenv charge automatiquement depuis le fichier .env
#   - Ou via --dart-define ou --dart-define-from-file=.env

# URL du backend Django (sans slash final)
BABIFIX_API_BASE=http://10.0.2.2:8002

# URL WebSocket Django Channels (sans slash final)
BABIFIX_WS_BASE=ws://10.0.2.2:8002

# ZEGOCLOUD Voice/Video Call
# Obtenez ces valeurs sur https://console.zegocloud.com/
ZEGO_APP_ID=
ZEGO_APP_SIGN=

# Sentry (optionnel)
BABIFIX_SENTRY_DSN=

# Environment: development | staging | production
BABIFIX_ENV=development
