<?xml version="1.0" encoding="utf-8"?>
<!-- Splash natif Android — affiché avant le démarrage de Flutter.
     Fond dégradé navy + logo BABIFIX centré. Le splash Dart prend
     ensuite le relais avec les animations complètes (loader 4-anneaux,
     halo qui pulse, etc.). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/splash_gradient" />

    <item
        android:width="140dp"
        android:height="140dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/babifix_logo"
            android:gravity="center"
            android:antialias="true" />
    </item>
</layer-list>
