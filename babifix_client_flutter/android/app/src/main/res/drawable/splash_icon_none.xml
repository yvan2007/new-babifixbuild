<?xml version="1.0" encoding="utf-8"?>
<!-- Icône de splash volontairement TRANSPARENTE.
     Android 12+ impose une icône sur la SplashScreen API native ; on en
     fournit une invisible pour que le splash natif ne soit qu'un fond navy
     uni. Le vrai logo BABIFIX (+ le texte CLIENT/PRESTATAIRE) s'anime
     ensuite UNE SEULE FOIS sur le splash Dart — plus aucun doublon. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
