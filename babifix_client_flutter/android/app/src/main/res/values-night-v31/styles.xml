<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) — Override de la SplashScreen API native.

  Par défaut Android 12 affiche l'icône launcher dans un CERCLE BLANC
  AVANT le splash Flutter. On désactive ce cercle blanc et on aligne
  le fond avec notre navy pour qu'il n'y ait AUCUN saut visuel entre
  le splash natif et le splash Dart.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- Fond navy plein (sans cercle blanc) -->
        <item name="android:windowSplashScreenBackground">@color/babifix_navy</item>
        <!-- Pas de cercle de fond derrière l'icône splash -->
        <item name="android:windowSplashScreenIconBackgroundColor">@color/babifix_navy</item>
        <!-- Notre logo BABIFIX (PNG transparent) -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/babifix_logo</item>
        <!-- Status bar transparente pour fondu propre -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/babifix_navy</item>
    </style>
</resources>
