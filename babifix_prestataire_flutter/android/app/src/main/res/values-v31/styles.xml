<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) — Override de la SplashScreen API native.

  Android 12 IMPOSE une icône sur le splash natif (sinon il affiche l'icône
  launcher dans un cercle blanc). On lui fournit donc une icône TRANSPARENTE
  sur un fond navy uni : le splash natif n'affiche AUCUN logo. Le logo
  BABIFIX + le texte « PRESTATAIRE » s'animent ensuite UNE SEULE FOIS sur le
  splash Dart → plus de doublon de logo, on arrive directement sur l'écran
  avec les écritures.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- Fond navy plein -->
        <item name="android:windowSplashScreenBackground">@color/babifix_navy</item>
        <!-- Cercle d'icône navy = invisible -->
        <item name="android:windowSplashScreenIconBackgroundColor">@color/babifix_navy</item>
        <!-- Icône transparente : aucun logo sur le splash natif -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
        <!-- Status bar transparente pour fondu propre -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/babifix_navy</item>
    </style>
</resources>
