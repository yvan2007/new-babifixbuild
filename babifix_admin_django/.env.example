# =============================================
# BABIFIX - Configuration environnement
# =============================================

# =============================================
# EMAIL SMTP (Gmail, Mailjet, SendGrid, etc.)
# =============================================
# Utiliser console.EmailBackend en dev local
# Changer vers smtp.EmailBackend en prod

# Gmail (gratuit, 100 emails/jour)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-app
DEFAULT_FROM_EMAIL=BABIFIX <contact@babifix.ci>

# =============================================
# APPLE SIGN-IN (nécessite Apple Developer $99/an)
# =============================================
APPLE_BUNDLE_ID=com.babifix.client.app
APPLE_TEAM_ID=VOTRE_TEAM_ID
APPLE_KEY_ID=VOTRE_KEY_ID
APPLE_PRIVATE_KEY=VOTRE_CLE_Privee_Sans_SautDeLigne

# =============================================
# SÉCURITÉ — OBLIGATOIRE EN PRODUCTION
# =============================================
# Mode : development | staging | production
DJANGO_ENV=development

# Clé secrète Django (générer : python -c "import secrets; print(secrets.token_urlsafe(64))")
DJANGO_SECRET_KEY=

# Hosts autorisés (séparés par virgule)
DJANGO_ALLOWED_HOSTS=babifix.ci,www.babifix.ci

# Origines de confiance pour le CSRF (HTTPS uniquement en prod)
DJANGO_CSRF_TRUSTED_ORIGINS=https://babifix.ci,https://www.babifix.ci

# Origines CORS autorisées
CORS_ALLOWED_ORIGINS=https://babifix.ci,https://www.babifix.ci

# JWT — secret HMAC, ou utilisez RS256 via JWT_PUBLIC_KEY_PATH/JWT_PRIVATE_KEY_PATH
JWT_SECRET_KEY=

# =============================================
# PAIEMENTS (Mobile Money) — OBLIGATOIRE EN PRODUCTION
# =============================================
GENIUSPAY_PUBLIC_KEY=
GENIUSPAY_SECRET_KEY=
GENIUSPAY_WEBHOOK_URL=https://api.babifix.ci/api/paiements/geniuspay/webhook/
GENIUSPAY_SUCCESS_URL=https://app.babifix.ci/payment-success
GENIUSPAY_ERROR_URL=https://app.babifix.ci/payment-error

CINETPAY_APIKEY=
CINETPAY_SITE_ID=
CINETPAY_NOTIFY_URL=https://api.babifix.ci/api/paiements/cinetpay/webhook/
CINETPAY_RETURN_URL=https://app.babifix.ci/payment-return

# =============================================
# FIREBASE (push notifications)
# =============================================
# Chemin vers la clé de compte de service Firebase Admin (JSON)
FIREBASE_CREDENTIALS_JSON_PATH=/secrets/firebase-admin.json

# =============================================
# SOCIAL AUTH GOOGLE
# =============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================
# BASE DE DONNÉES (Postgres recommandé en prod)
# =============================================
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/babifix

# =============================================
# REDIS (cache + Celery + Channels)
# =============================================
REDIS_URL=redis://localhost:6379/0

# =============================================
# SENTRY (monitoring erreurs prod)
# =============================================
SENTRY_DSN=

# =============================================
# RATE LIMITING (valeurs par défaut adaptées)
# =============================================
BABIFIX_THROTTLE_LOGIN_RATE=5
BABIFIX_THROTTLE_LOGIN_WINDOW=60